# Final validated benchmark defaults. Existing environment variables win.
: "${CTX:=512}"
: "${NGL:=all}"
: "${FIT:=off}"
: "${PARALLEL:=1}"
: "${BATCH_SIZE:=128}"
: "${UBATCH_SIZE:=64}"
: "${MTMD_BATCH_TOKENS:=128}"
: "${CACHE_TYPE_K:=q8_0}"
: "${CACHE_TYPE_V:=q8_0}"
: "${LOAD_MODE:=mmap}"
: "${HOST:=127.0.0.1}"
: "${PORT:=8080}"
